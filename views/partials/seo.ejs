<%
  const isPost = Boolean(locals.post && post.slug);
  const isHome = currentPath === '/';
  const baseTitle = isHome ? `${authorName} | ${siteSubtitle}` : (locals.title ? `${title} | ${authorName}` : `${siteTitle} | ${authorName}`);
  const pageTitle = isPost ? `${post.title} | ${authorName}` : baseTitle;
  const fallbackDesc = `${authorName} (${siteAuthor}): ML research engineer writing about speech AI, Indian-language voice agents, embeddings and real-time systems.`;
  const rawDesc = isPost && post.excerpt ? String(post.excerpt) : fallbackDesc;
  const desc = rawDesc.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim().slice(0, 160);
  const pageUrl = siteUrl + (currentPath === '/' ? '/' : currentPath.replace(/\/+$/, ''));
  const person = { '@type': 'Person', name: authorName, alternateName: siteAuthor, url: siteUrl + '/about' };
  const ld = isPost ? {
    '@context': 'https://schema.org', '@type': 'BlogPosting',
    headline: post.title, description: desc, url: pageUrl, mainEntityOfPage: pageUrl,
    datePublished: new Date(post.date).toISOString(), keywords: (post.tags || []).join(', '),
    author: person, publisher: person
  } : {
    '@context': 'https://schema.org', '@type': 'Person', name: authorName, alternateName: siteAuthor,
    jobTitle: 'ML Research Engineer', url: siteUrl,
    sameAs: ['https://github.com/coderatwork7', 'https://github.com/somiljain7', 'https://x.com/coderatwork7', 'https://www.linkedin.com/in/somiljain7/']
  };
%>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= desc %>">
  <meta name="author" content="<%= authorName %>">
  <link rel="canonical" href="<%= pageUrl %>">
  <meta property="og:type" content="<%= isPost ? 'article' : 'website' %>">
  <meta property="og:site_name" content="<%= authorName %> · <%= siteTitle %>">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= desc %>">
  <meta property="og:url" content="<%= pageUrl %>">
<% if (isPost) { %>
  <meta property="article:published_time" content="<%= new Date(post.date).toISOString() %>">
  <% (post.tags || []).forEach(t => { %><meta property="article:tag" content="<%= t %>">
  <% }) %><link rel="alternate" type="text/markdown" title="Markdown version" href="<%= siteUrl %>/post/<%= post.slug %>.md">
<% } %>
  <meta name="twitter:card" content="summary">
  <meta name="twitter:site" content="@coderatwork7">
  <meta name="twitter:title" content="<%= pageTitle %>">
  <meta name="twitter:description" content="<%= desc %>">
  <script type="application/ld+json"><%- JSON.stringify(ld).replace(/</g, '\\u003c') %></script>
