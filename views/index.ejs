<section class="hero">
  <div class="hero-titlebar">
    <span class="hero-dot"></span>
    <span class="hero-dot"></span>
    <span class="hero-dot"></span>
    <span class="hero-path">~/coderatwork7 — zsh</span>
  </div>
  <div class="hero-body">
    <div class="hero-line"><span class="prompt">$</span>whoami</div>
    <div class="hero-name"><%= siteAuthor %></div>
    <div class="hero-typed" id="hero-typed"></div>
    <canvas class="hero-wave" id="hero-wave" aria-hidden="true"></canvas>
  </div>
  <div class="hero-tags">
    <span>speech</span>
    <span>speaker diarization</span>
    <span>streaming STT/TTS</span>
    <span>document intelligence</span>
    <span>conversational AI</span>
  </div>
</section>

<div class="blog-index">
  <% if (posts.length === 0) { %>
    <div class="empty-state">
      <h3>No posts yet</h3>
      <p>Posts published will appear here.</p>
    </div>
  <% } %>

  <% posts.forEach(post => { %>
    <article class="post-preview <%= post.pinned ? 'post-pinned' : '' %>">
      <div class="post-meta">
        <time datetime="<%= post.date.toISOString() %>">
          <%= post.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
        </time>
        
        <span class="read-time"><%= post.readingTime %> min read</span>

        <% if (post.mood) { %>
          <span class="mood-badge"><%= post.mood %></span>
        <% } %>

        <% if (post.visibility && post.visibility !== 'public') { %>
          <span class="visibility-badge <%= post.visibility %>">
            <%= post.visibility %>
          </span>
        <% } %>

        <% if (post.pinned) { %>
          <span class="pin-badge">Pinned</span>
        <% } %>

        <% if (isAuthenticated) { %>
          <a href="/admin/edit/<%= post.slug %>" class="quick-edit-link" title="Edit Post">Edit</a>
        <% } %>
      </div>

      <h2 class="post-title">
        <a href="/post/<%= post.slug %>"><%= post.title %></a>
      </h2>

      <p class="post-excerpt"><%= post.excerpt %></p>

      <div class="post-footer-meta">
        <% if (post.categories && post.categories.length > 0) { %>
          <span class="categories">
            <% post.categories.forEach(cat => { %>
              <a href="/category/<%= cat %>" class="category-tag"><%= cat %></a>
            <% }); %>
          </span>
        <% } %>

        <% if (post.tags && post.tags.length > 0) { %>
          <div class="tags">
            <% post.tags.forEach(tag => { %>
              <a href="/tag/<%= tag %>" class="tag">#<%= tag %></a>
            <% }); %>
          </div>
        <% } %>

        <a href="/post/<%= post.slug %>" class="read-more">Read more →</a>
      </div>
    </article>
  <% }); %>

  <% if (pages > 1) { %>
    <div class="pagination">
      <% if (page > 1) { %>
        <a href="/?page=<%= page - 1 %>" class="prev">← Previous</a>
      <% } %>
      <span class="page-info">Page <%= page %> of <%= pages %></span>
      <% if (page < pages) { %>
        <a href="/?page=<%= page + 1 %>" class="next">Next →</a>
      <% } %>
    </div>
  <% } %>
</div>
