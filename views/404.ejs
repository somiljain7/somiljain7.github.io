<div class="not-found-container">
  <div class="terminal-card">
    <div class="hero-titlebar">
      <span class="hero-dot"></span>
      <span class="hero-dot"></span>
      <span class="hero-dot"></span>
      <span class="hero-path">error: 404 — resource not found</span>
    </div>
    <div class="terminal-card-body" style="text-align: center; padding: 3rem 1.5rem;">
      <h1 style="font-size: 3.5rem; color: var(--accent); margin-bottom: 0.5rem; font-family: var(--font-mono);">404</h1>
      <h2><%= typeof title !== 'undefined' ? title : 'Page Not Found' %></h2>
      <p style="color: var(--fg-secondary); margin: 1rem 0 2rem;">
        <%= typeof message !== 'undefined' ? message : "The requested diary entry, category, or page could not be located." %>
      </p>
      <a href="/" class="btn btn-primary">← Return to Journal Feed</a>
    </div>
  </div>
</div>
