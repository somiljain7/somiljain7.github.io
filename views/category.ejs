<div class="category-page">
  <div class="page-header">
    <h1 class="page-title">Category: <span class="accent-text"><%= category %></span></h1>
    <p class="page-subtitle"><%= count %> <%= count === 1 ? 'entry' : 'entries' %> found in this collection</p>
  </div>

  <div class="posts-list">
    <% posts.forEach(post => { %>
      <article class="post-preview">
        <div class="post-meta-top">
          <time datetime="<%= post.date.toISOString() %>">
            <%= post.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
          </time>
          <span class="read-time"><%= post.readingTime %> min read</span>
          <% if (post.mood) { %>
            <span class="mood-badge"><%= post.mood %></span>
          <% } %>
          <% if (post.visibility && post.visibility !== 'public') { %>
            <span class="visibility-badge <%= post.visibility %>"><%= post.visibility %></span>
          <% } %>
        </div>

        <h2 class="post-title">
          <a href="/post/<%= post.slug %>"><%= post.title %></a>
        </h2>

        <p class="post-excerpt"><%= post.excerpt %></p>

        <div class="post-footer-meta">
          <% if (post.tags && post.tags.length > 0) { %>
            <div class="tags">
              <% post.tags.forEach(tag => { %>
                <a href="/tag/<%= tag %>" class="tag">#<%= tag %></a>
              <% }); %>
            </div>
          <% } %>
          <a href="/post/<%= post.slug %>" class="read-more">Read more →</a>
        </div>
      </article>
    <% }); %>
  </div>

  <nav class="back-nav">
    <a href="/" class="back-link">← Back to Blog</a>
  </nav>
</div>
