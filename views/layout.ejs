<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' && title ? title + ' - ' : '' %><%= siteTitle %></title>
  <link rel="stylesheet" href="/style.css">
  <link rel="alternate" type="application/rss+xml" title="<%= siteTitle %> Feed" href="/feed">
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,700;1,400&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="dark-mode">
  <div id="dark-mode-toggle" class="dark-mode-toggle" title="Toggle Dark/Light Mode">🌙</div>
  <button id="music-toggle" class="music-toggle" title="Play background ambient music" aria-pressed="false">
    <span class="music-icon" aria-hidden="true">🎧</span>
  </button>
  <audio id="bg-audio" src="/audio/ambient.mp3" loop preload="none"></audio>
  
  <header class="header">
    <nav class="navbar">
      <div class="container">
        <div class="nav-brand">
          <h1 class="site-title">
            <a href="/"><%= siteTitle %></a>
            <span class="eq-bars" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></span>
          </h1>
          <span class="site-subtitle"><%= siteSubtitle %></span>
        </div>
        
        <div class="nav-center">
          <input type="text" id="search-box" placeholder="Search posts..." class="search-input" />
        </div>

        <button id="nav-toggle" class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>

        <ul id="nav-links" class="nav-links">
          <li><a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>">Blog</a></li>
          <li><a href="/about" class="nav-link <%= currentPath === '/about' ? 'active' : '' %>">About</a></li>
          <li><a href="/cv" class="nav-link <%= currentPath === '/cv' ? 'active' : '' %>">CV</a></li>
          <li><a href="/publications" class="nav-link <%= currentPath === '/publications' ? 'active' : '' %>">Publications</a></li>
          <li><a href="/archives" class="nav-link <%= currentPath === '/archives' ? 'active' : '' %>">Archive</a></li>
          <% if (isAuthenticated) { %>
            <li><a href="/admin" class="nav-link nav-btn-admin <%= currentPath.startsWith('/admin') ? 'active' : '' %>">Writer</a></li>
            <li><a href="/logout" class="nav-link nav-btn-logout" title="Logout">Logout</a></li>
          <% } %>
        </ul>
      </div>
    </nav>
  </header>

  <div id="search-results" class="search-results hidden"></div>

  <main class="container main-content">
    <%- body %>
  </main>

  <footer class="footer">
    <div class="footer-content container">
      <div class="footer-section">
        <h3><%= siteTitle %></h3>
        <p><%= siteSubtitle %></p>
        <p class="footer-meta">ML Research Engineer passionate about speech processing, document intelligence, and conversational AI.</p>
      </div>
      <div class="footer-section">
        <h4>Quick Links</h4>
        <ul>
          <li><a href="/">Blog</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/cv">CV</a></li>
          <li><a href="/publications">Publications</a></li>
          <li><a href="/archives">Archive</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h4>Connect</h4>
        <ul>
          <li><a href="https://github.com/coderatwork7" target="_blank" rel="noopener">GitHub</a></li>
          <li><a href="https://x.com/coderatwork7" target="_blank" rel="noopener">Twitter / X</a></li>
          <li><a href="https://linkedin.com" target="_blank" rel="noopener">LinkedIn</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; <%= new Date().getFullYear() %> <%= siteAuthor %> • Built with Node.js & Markdown</p>
    </div>
  </footer>

  <script src="/app.js"></script>
</body>
</html>
