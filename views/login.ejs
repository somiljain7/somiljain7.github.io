<div class="login-container">
  <div class="terminal-card">
    <div class="hero-titlebar">
      <span class="hero-dot"></span>
      <span class="hero-dot"></span>
      <span class="hero-dot"></span>
      <span class="hero-path">~/auth — admin access</span>
    </div>
    
    <div class="terminal-card-body">
      <div class="login-header">
        <h2>Terminal Authentication</h2>
        <p class="login-subtitle">Enter password to access publisher controls</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error">
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/login" method="POST" class="login-form">
        <input type="hidden" name="next" value="<%= next %>">
        
        <div class="form-group">
          <label for="password" class="form-label"><span class="prompt">$</span> enter_password:</label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            class="form-control" 
            placeholder="••••••••••••" 
            required 
            autofocus 
          />
        </div>

        <button type="submit" class="btn btn-primary btn-block">Authenticate →</button>
      </form>

      <div class="login-footer">
        <a href="/" class="back-link">← Return to site</a>
      </div>
    </div>
  </div>
</div>
